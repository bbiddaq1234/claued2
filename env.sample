# 이 파일을 복사해서 .env.local 이라는 이름으로 저장한 뒤, 아래 값을 채우세요.
#   맥/리눅스: cp env.sample .env.local
#   윈도우:    copy env.sample .env.local
#
# ⚠️ 열쇠(키)를 넣은 뒤에는 앱을 껐다 켜야(dev 서버 재시작) 반영됩니다.
# 아래 항목은 전부 "선택"입니다 — 아무것도 안 채워도 앱은 그대로 켜집니다.
# (AI로 사진을 직접 만드는 기능만 못 씁니다. 사진은 검색해서 가져오거나
#  직접 찍은 사진을 써도 됩니다.)

# ── AI로 사진 생성하기(선택) ────────────────────────────────────
# Cloudflare Workers AI 계정의 "Account ID"와 API 토큰입니다.
# 대시보드(dash.cloudflare.com) → 오른쪽 사이드바에서 Account ID를 확인하고,
# "My Profile → API Tokens"에서 새 토큰을 만드세요. Workers AI 사용 권한이 필요합니다.
# (뉴런 실측 사용량까지 보고 싶다면 토큰에 "Account Analytics: Read" 권한도 추가하세요.
#  이미 만든 토큰에 권한을 추가할 땐 "Edit"을 쓰세요 — "Roll"은 토큰 자체를 바꿔버려서
#  여기 적어둔 값이 무효가 됩니다.)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── 아래는 잘 안 건드려도 됩니다 ─────────────────────────────────
# 특별한 이유가 없다면 비워두세요. 처음 켤 때만 적용되는 기본값이고,
# 이후에는 앱 화면의 "설정"에서 바꾼 값이 우선합니다.

# 데이터(로그인 정보/사진/스크린샷/기록)를 저장할 위치. 비우면 ./data
# DATA_DIR=

# claude 프로그램의 위치를 못 찾을 때만 채우세요(주로 윈도우에서).
# 예: C:\Users\내이름\AppData\Roaming\npm\claude.cmd
# CLAUDE_BIN=

# 하루에 몇 편까지 발행할지(기본 3), 발행 사이 최소 간격(분, 기본 30)
# DAILY_PUBLISH_LIMIT=
# MIN_PUBLISH_INTERVAL_MIN=

# 뉴스/블로그를 한 번에 몇 건 모을지(기본 8), 사진 후보를 몇 개까지 볼지(기본 10)
# SCRAPE_TOP_N=
# IMAGE_CANDIDATES=

# AI로 사진을 만들 때 품질(스텝, 1~8, 기본 6) — 높을수록 좋아지지만 더 많이 씁니다
# CF_IMAGE_STEPS=

# 자동화 중인 브라우저 창을 화면에 보이게 할지(기본: 안 보임)
# SHOW_BROWSER=

# AI 응답을 몇 초까지 기다릴지(기본 180), AI를 동시에 몇 개까지 실행할지(기본 2)
# CLAUDE_TIMEOUT_SEC=
# CLAUDE_CONCURRENCY=
